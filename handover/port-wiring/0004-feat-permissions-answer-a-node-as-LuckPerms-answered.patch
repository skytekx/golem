 crates/golem-permissions/src/lib.rs     | 17 ++++++++
 okf/plugins/permissions.md              |  9 +++--
 tests/notebooks/06_permissions.ipynb    | 54 +++++++++++++++++++++++++
 4 files changed, 88 insertions(+), 6 deletions(-)

diff --git a/crates/golem-devtool/src/permissions.rs b/crates/golem-devtool/src/permissions.rs
index 83c8c84..d390819 100644
--- a/crates/golem-devtool/src/permissions.rs
+++ b/crates/golem-devtool/src/permissions.rs
@@ -2,8 +2,8 @@
 // SPDX-FileCopyrightText: 2026 Florian Kleber <opensource@skytekx.com>
 /*
  * The subcommands of golem-permissions: permissions prints the decisions of a configuration for
- * a player and nodes, and permissions-groups prints the groups of a player in the order a check
- * searches them, each with its nodes.
+ * a player and nodes, with what LuckPerms answered for them on Bukkit, and permissions-groups
+ * prints the groups of a player in the order a check searches them, each with its nodes.
  */
 
 use std::{
@@ -54,7 +54,15 @@ fn check(arguments: &[String]) -> i32 {
         .iter()
         .map(|node| {
             let decision = permissions.check(player, node);
-            json!({"node": node, "value": decision.value, "reason": decision.reason})
+            json!({
+                "node": node,
+                "value": decision.value,
+                "reason": decision.reason,
+                "hasPermission": {
+                    "player": permissions.has_permission(player, node, false),
+                    "operator": permissions.has_permission(player, node, true),
+                },
+            })
         })
         .collect();
     let mut output = json!({ "decisions": decisions });
diff --git a/crates/golem-permissions/src/lib.rs b/crates/golem-permissions/src/lib.rs
index 663f21b..6110ad4 100644
--- a/crates/golem-permissions/src/lib.rs
+++ b/crates/golem-permissions/src/lib.rs
@@ -202,6 +202,23 @@ impl Permissions {
         resolve::resolve(self, uuid, node).value()
     }
 
+    /// Whether the player with `uuid` holds `node` as `LuckPerms` 5.5.71 answers
+    /// `Player.hasPermission` on Bukkit for a node that no plugin declares, which is how Arclight
+    /// asked it every Boolean node of the `PermissionAPI` of Forge for an online player.
+    ///
+    /// `LuckPerms` lowercases the node before it looks at it, so this does too. A node that a rule
+    /// names decides as [`Permissions::value`] answers it, and a node that no rule names is
+    /// granted to an operator and denied to every other player, as the processor of `LuckPerms`
+    /// for operators answers it. It allocates nothing for a node in lower case.
+    pub fn has_permission(&self, uuid: &str, node: &str, operator: bool) -> bool {
+        let value = if node.bytes().any(|byte| byte.is_ascii_uppercase()) {
+            self.value(uuid, &node.to_ascii_lowercase())
+        } else {
+            self.value(uuid, node)
+        };
+        value.unwrap_or(operator)
+    }
+
     /// The groups of the player with `uuid` in the order a check searches them, or `None` when
     /// `uuid` is no UUID. A player that the configuration does not name is in the default group
     /// and what it inherits.
diff --git a/okf/plugins/permissions.md b/okf/plugins/permissions.md
index 785df9a..c2372dd 100644
--- a/okf/plugins/permissions.md
+++ b/okf/plugins/permissions.md
@@ -157,15 +157,18 @@ it cannot place.
 | `Permissions::from_toml(text)` | The permissions of a configuration, or the `ConfigError` that names where it breaks a rule |
 | `Permissions::check(uuid, node)` | A `Decision` with `value`, true, false or none, and the `reason` |
 | `Permissions::value(uuid, node)` | The value alone, without building the reason, for the server thread |
+| `Permissions::has_permission(uuid, node, operator)` | What LuckPerms 5.5.71 answered `Player.hasPermission` on Bukkit for a node that no plugin declares: the node in lower case decides as `value` answers it, and a node that no rule names is true for an operator and false for every other player |
 | `Permissions::groups_of(uuid)` | The groups of a player in the search order, each with weight, depth and rank |
 | `Permissions::group_nodes(name)` | The nodes of a group as the file writes them, a deny with its `-` |
 | `Permissions::group_names()` | The names of the groups, sorted |
 | `DEFAULT_GROUP` | The name `default` |
 
 `golem-devtool permissions --config <file> --player <uuid> --node <node>...` prints
-`{"decisions": [{"node", "value", "reason"}]}`, and `golem-devtool permissions-groups --config
-<file> --player <uuid>` prints the groups of a player with their weight, depth, rank and nodes. A
-broken configuration goes to standard error with the exit status 1.
+`{"decisions": [{"node", "value", "reason", "hasPermission"}]}`, where `hasPermission` holds the
+answer of `has_permission` for a player and for an operator, and
+`golem-devtool permissions-groups --config <file> --player <uuid>` prints the groups of a player
+with their weight, depth, rank and nodes. A broken configuration goes to standard error with the
+exit status 1.
 
 ## The cost of a check
 
