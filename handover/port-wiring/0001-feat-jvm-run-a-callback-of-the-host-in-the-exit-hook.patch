 crates/golem-jvm/src/invocation.rs | 31 +++++++++++++++++++++++++++---
 crates/golem-jvm/src/lib.rs        | 16 ++++++++++++++-
 okf/jvm-host.md                    | 10 +++++++---
 3 files changed, 50 insertions(+), 7 deletions(-)

diff --git a/crates/golem-jvm/src/invocation.rs b/crates/golem-jvm/src/invocation.rs
index de8003b..31c398c 100644
--- a/crates/golem-jvm/src/invocation.rs
+++ b/crates/golem-jvm/src/invocation.rs
@@ -28,9 +28,12 @@ use std::{
         PathBuf, //
     },
     ptr,
-    sync::atomic::{
-        AtomicBool,
-        Ordering, //
+    sync::{
+        OnceLock,
+        atomic::{
+            AtomicBool,
+            Ordering, //
+        },
     },
 };
 
@@ -83,10 +86,32 @@ fn log(line: std::fmt::Arguments<'_>) {
     let _ = writeln!(std::io::stderr(), "[golem] {line}");
 }
 
+/// What the exit hook runs after its line, which [`crate::on_exit`] sets once.
+static ON_EXIT: OnceLock<Box<dyn Fn(i32) + Send + Sync>> = OnceLock::new();
+
+/// Sets what the exit hook runs, and answers false when it was set already.
+pub(crate) fn on_exit(callback: Box<dyn Fn(i32) + Send + Sync>) -> bool {
+    ON_EXIT.set(callback).is_ok()
+}
+
 /// The exit hook of the JVM, which `HotSpot` calls with the status of `System.exit` or `Runtime.halt`
 /// before it ends the process itself.
+///
+/// The shutdown hooks of Java have run by then, so the server has stopped and saved, and the
+/// callback of the host runs last, such as the close of the store. A panic of the callback is
+/// caught and logged, since the process ends either way.
 extern "system" fn exit_hook(status: sys::jint) {
     let _ = std::panic::catch_unwind(|| log(format_args!("the JVM exits with status {status}")));
+    if let Some(callback) = ON_EXIT.get() {
+        let called = std::panic::catch_unwind(AssertUnwindSafe(|| callback(status)));
+        if called.is_err() {
+            let _ = std::panic::catch_unwind(|| {
+                log(format_args!(
+                    "the callback of the exit hook panicked, so the process ends without it"
+                ));
+            });
+        }
+    }
 }
 
 /// True once `JNI_CreateJavaVM` has created the JVM.
diff --git a/crates/golem-jvm/src/lib.rs b/crates/golem-jvm/src/lib.rs
index d8afb80..645243c 100644
--- a/crates/golem-jvm/src/lib.rs
+++ b/crates/golem-jvm/src/lib.rs
@@ -180,7 +180,8 @@ pub struct Outcome {
 ///
 /// The JVM runs on a thread of its own. `register` runs on that thread after the JVM exists and
 /// before the main class, to register native methods. A call to `System.exit` in the JVM ends the
-/// process after the exit hook of the host has logged it, so this function does not return then.
+/// process after the exit hook of the host has logged it and run the callback of [`on_exit`], so
+/// this function does not return then.
 ///
 /// The thread is named golem-jvm and has a stack of 8 MiB, or the size of `-Xss` when that is
 /// larger. The options of `spec` reach `JNI_CreateJavaVM` in their order, followed by
@@ -201,6 +202,19 @@ where
     invocation::run(java_home, spec, register)
 }
 
+/// Sets what the exit hook of the JVM runs after it logged the status, and answers false when a
+/// callback was set already, which stays.
+///
+/// `HotSpot` calls the exit hook on `System.exit` and `Runtime.halt`, after the shutdown hooks of
+/// Java, so the server has stopped and saved by then, and ends the process when the hook returns.
+/// [`run`] never returns then, so the host closes what it must close in this callback, such as
+/// the store of the plugins. The callback runs on the thread of `HotSpot` that ends the JVM, while
+/// the threads of Java wait at a safepoint, so it calls nothing of the JVM and returns quickly. A
+/// panic of the callback is caught and logged.
+pub fn on_exit(callback: Box<dyn Fn(i32) + Send + Sync>) -> bool {
+    invocation::on_exit(callback)
+}
+
 /// Answers whether the signal of number `signal` was ignored when the process started, as
 /// `nohup` leaves `SIGHUP`.
 ///
diff --git a/okf/jvm-host.md b/okf/jvm-host.md
index a8af73d..e1d3eaf 100644
--- a/okf/jvm-host.md
+++ b/okf/jvm-host.md
@@ -213,11 +213,15 @@ A process holds one JVM, so `run` runs once.
 
 | Hook | When HotSpot calls it | What the host does |
 | --- | --- | --- |
-| `exit` | `System.exit` or `Runtime.halt`, with the status | Logs `[golem] the JVM exits with status N` on standard error, then HotSpot ends the process with that status |
+| `exit` | `System.exit` or `Runtime.halt`, with the status, after the shutdown hooks of Java | Logs `[golem] the JVM exits with status N` on standard error and runs the callback that the host set with `golem_jvm::on_exit`, which closes the store in `golem run`, then HotSpot ends the process with that status |
 | `abort` | A fatal error, or an error of the options that HotSpot finds while `JNI_CreateJavaVM` runs, before HotSpot aborts the process | Logs `[golem] the JVM aborts on a fatal error`, or `[golem] the JVM could not start, see its message above` while `JNI_CreateJavaVM` runs |
 
-Both hooks catch every panic, so none unwinds into the JVM. `run` does not return after a hook,
-since the process ends.
+Both hooks catch every panic, so none unwinds into the JVM, and a callback of the exit hook that
+panics is logged. `run` does not return after a hook, since the process ends. HotSpot calls the
+exit hook on its own thread while every thread of Java waits at a safepoint, so the callback calls
+nothing of the JVM. The store of the plugins closes there, since `golem run` never gets back from
+`golem_jvm::run` when the JVM ends through `System.exit`, see
+[Store](store.md#the-place-in-the-program-golem).
 
 Before it creates the JVM, the host puts `SIGSEGV` and `SIGBUS` back to their default action. The
