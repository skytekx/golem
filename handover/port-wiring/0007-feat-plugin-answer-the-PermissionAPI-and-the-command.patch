+    "## The plugin of the permissions and the PermissionAPI\n",
+    "\n",
+    "The plugin `golem-permissions` of the runtime answers every Boolean node of the PermissionAPI of\n",
+    "Forge for an online player as LuckPerms answered it through Arclight: a node that a rule names as\n",
+    "the rule says, after it lowercased the node, and a node that nothing names true for an operator,\n",
+    "a player on the list of operators at a level of 1 or more, and false for every other player. A\n",
+    "player who is not online gets no answer, so the node falls to its default resolver, as Arclight\n",
+    "left an offline player to it. On the server thread the plugin asks the game for the level, and on\n",
+    "any other thread it answers from the levels it keeps from the joins, so a check of the thread of\n",
+    "a mod, such as the thread of Simple Voice Chat, answers Alex, an operator, as an operator until\n",
+    "Alex leaves."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "04d000002",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "FORGE_NODES = [\"voicechat.listen\", \"voicechat.speak\", \"VoiceChat.Listen\"]\n",
+    "API_PERMISSIONS = '''\n",
+    "[groups.default]\n",
+    "nodes = [\"voicechat.listen\"]\n",
+    "\n",
+    "[players.%s]\n",
+    "nodes = [\"-voicechat.listen\"]\n",
+    "''' % SAM[\"uuid\"]\n",
+    "NOBODY = {\"uuid\": \"00000000-0000-4000-8000-00000000abcd\", \"name\": \"Nobody\"}\n",
+    "asks = [{\"op\": \"permission\", \"uuid\": who[\"uuid\"], \"node\": node} for who in (ALEX, SAM, NOBODY) for node in FORGE_NODES]\n",
+    "LEVELS = {\"players\": [{**ALEX, \"level\": 4, \"location\": NETHER}, {**SAM, \"level\": 0, \"location\": LAVA}],\n",
+    "          \"dimensions\": [OVERWORLD]}\n",
+    "api, log = script(\"permission-api\", {\n",
+    "    \"budgetMs\": budget_ms,\n",
+    "    \"plugins\": [{\"kind\": \"permissions\"}],\n",
+    "    \"permissions\": API_PERMISSIONS,\n",
+    "    \"game\": LEVELS,\n",
+    "    \"steps\": [{\"op\": \"serverStarting\", \"forgeVersion\": \"47.4.18\", \"minecraftVersion\": \"1.20.1\"},\n",
+    "              {\"op\": \"playerJoined\", **ALEX}, {\"op\": \"playerJoined\", **SAM}]\n",
+    "             + asks\n",
+    "             + [{\"op\": \"together\", \"steps\": [{\"op\": \"permission\", \"uuid\": ALEX[\"uuid\"], \"node\": \"voicechat.speak\"},\n",
+    "                                             {\"op\": \"permission\", \"uuid\": NOBODY[\"uuid\"], \"node\": \"voicechat.speak\"}]},\n",
+    "                {\"op\": \"playerLeft\", **ALEX},\n",
+    "                {\"op\": \"together\", \"steps\": [{\"op\": \"permission\", \"uuid\": ALEX[\"uuid\"], \"node\": \"voicechat.speak\"}]}],\n",
+    "})\n",
+    "answers = [step[\"answer\"] for step in api[3:3 + len(asks)]]\n",
+    "print(\"on the server thread:\", answers)\n",
+    "assert answers == [True, True, True, False, False, False, None, None, None], answers\n",
+    "beside = [step[\"answer\"] for step in api[3 + len(asks)][\"answer\"]]\n",
+    "after = [step[\"answer\"] for step in api[-1][\"answer\"]]\n",
+    "print(\"on another thread:\", beside, \"after Alex left:\", after)\n",
+    "assert beside == [True, None] and after == [None], (beside, after)\n",
+    "assert log == [], log"
+   ]
+  },
