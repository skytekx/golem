From 8e3e405d524ecb2a6e81978d9b0b0bf6a682726d Mon Sep 17 00:00:00 2001
From: Florian Kleber <26285351+kleberbaum@users.noreply.github.com>
Date: Sat, 7 Nov 2026 08:34:13 +0000
Subject: [PATCH 9/9] test(store): leave the answer of luckperms to notebook 06
 in notebook 09

Unfinished work of the agent that wired the permissions, stopped at the
hand over: a decision of the permissions now also holds the answer that
LuckPerms gave on Bukkit, so notebook 09 compares only the node, the
value and the reason. Not run yet.

Signed-off-by: Florian Kleber <opensource@skytekx.com>
---
 tests/notebooks/09_store.ipynb | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/notebooks/09_store.ipynb b/tests/notebooks/09_store.ipynb
index 4000e93..e174d6f 100644
--- a/tests/notebooks/09_store.ipynb
+++ b/tests/notebooks/09_store.ipynb
@@ -991,7 +991,9 @@
     "    from_store = decisions(name, KIM)\n",
     "    assert from_store == from_seed, \"the set of %s decides otherwise:\\n%s\\n%s\" % (name, from_store, from_seed)\n",
     "assert sum(decision[\"value\"] is True for decision in from_seed) == len(NODES), from_seed\n",
-    "alex = {decision[\"node\"]: decision for decision in decisions(\"store-permissions.toml\", ALEX)}\n",
+    "# A decision also holds the answer of LuckPerms on Bukkit, which the cell leaves to 06_permissions.\n",
+    "alex = {decision[\"node\"]: {key: decision[key] for key in (\"node\", \"value\", \"reason\")}\n",
+    "        for decision in decisions(\"store-permissions.toml\", ALEX)}\n",
     "assert alex[\"essentials.setspawn\"] == {\"node\": \"essentials.setspawn\", \"value\": True, \"reason\": \"Group admin grants essentials.*\"}, alex\n",
     "assert alex[\"essentials.suicide\"] == {\"node\": \"essentials.suicide\", \"value\": False, \"reason\": \"The player denies essentials.suicide\"}, alex\n",
     "assert alex[\"golem.perm\"][\"value\"] is True, alex\n",
