+        specs(&self.name, &self.commands)
+    }
+
+    fn on_command(
+        &mut self,
+        _name: &str,
+        sender: &Sender,
+        arguments: &str,
+        context: &mut Context<'_>,
+    ) -> Vec<String> {
+        arguments
+            .split_whitespace()
+            .map(|node| {
+                let answer = context.check_permission(sender, node);
+                format!(
+                    "{node}: granted {}, set {}, has {}, {}",
