+/// The respawn point that a player holds, as Minecraft stores it.
+#[derive(Clone, Debug, PartialEq)]
+pub struct RespawnPoint {
+    /// The block of the point: a bed, a respawn anchor or the block that `/spawnpoint` named.
+    pub block: BlockLocation,
+    /// The angle the player faces after a respawn there that no bed or anchor turns, in degrees.
+    pub angle: f32,
+    /// Whether `/spawnpoint` set the point, which then needs no bed or anchor, only room for
+    /// the player.
+    pub forced: bool,
+}
+
+/// Where a player would respawn now, as vanilla resolves the respawn point for a player who
+/// lives, without the charge of an anchor that a respawn after a death uses.
+#[derive(Clone, Debug, PartialEq)]
+pub enum RespawnPlace {
+    /// The place of the feet and the yaw, which faces a bed or an anchor, with the pitch 0.
+    At(Location),
+    /// The player holds no point, or the point holds no respawn now, such as a bed that is gone
+    /// or blocked or an anchor without a charge, so vanilla respawns them at the world spawn.
+    Nowhere,
+    /// A chunk around the point is not loaded, and a question loads no chunk.
+    Unloaded,
+}
+
+/// Whether a player may fly and flies.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Flight {
+    /// Whether the player may fly, as in creative, in spectator or by a mod.
+    pub allowed: bool,
+    /// Whether the player flies now.
+    pub flying: bool,
+}
+
+/// A stack of items in the inventory of a player.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Stack {
+    /// The slot: 0 to 8 the hotbar, 9 to 35 the rest of the inventory, 36 to 39 the armor from
+    /// the boots to the helmet and 40 the off hand, as the game and Bukkit number them.
+    pub slot: u32,
+    /// The registry id of the item, such as minecraft:diamond.
+    pub id: String,
+    /// How many items the stack holds.
+    pub count: u32,
+    /// The damage of the item, 0 for an item without durability.
+    pub damage: u32,
+    /// Whether the item places a block.
+    pub block: bool,
+}
+
+/// A dimension of the server, a level of the game.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Dimension {
+    /// The id, such as `minecraft:the_nether`.
+    pub id: String,
+    /// The id of its dimension type, such as `minecraft:the_nether`, which a dimension of a mod may
+    /// share with one of the game.
+    pub kind: String,
+    /// The heights of its blocks.
+    pub heights: Heights,
+    /// The logical height of its dimension type, how many blocks above the lowest a portal or a
+    /// chorus fruit may bring a player, such as 128 in the Nether.
+    pub logical_height: i32,
+    /// The sea level of its generator, such as 63 in the Overworld and 32 in the Nether.
+    pub sea_level: i32,
+    /// The time of day in ticks since the world began, which a day of 24000 ticks repeats.
+    pub day_time: i64,
+}
